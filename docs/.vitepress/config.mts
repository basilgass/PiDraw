import {fileURLToPath} from 'node:url'
import {defineConfig} from 'vitepress'
import {parseInfo} from './theme/fence'

// A grammar for the code of the examples: enough to tell the names, the keys, the options and the numbers apart.
const pidraw = {
    name: 'pidraw',
    scopeName: 'source.pidraw',
    patterns: [
        {name: 'comment.line.pidraw', match: '^\\s*\\$.*$'},
        {name: 'keyword.operator.pidraw', match: '->'},
        {
            // <name>=<key> at the start of a line.
            match: '^\\s*([A-Za-z_][\\w]*)(=)([a-z]+)',
            captures: {
                1: {name: 'variable.other.pidraw'},
                2: {name: 'keyword.operator.pidraw'},
                3: {name: 'keyword.control.pidraw'}
            }
        },
        {
            // The shorthand of a point: A(3,4).
            match: '^\\s*([A-Z][0-9]*)(?=\\()',
            captures: {1: {name: 'variable.other.pidraw'}}
        },
        {name: 'constant.numeric.pidraw', match: '(?<![\\w.])-?\\d+(\\.\\d+)?'},
        {name: 'string.unquoted.pidraw', match: '(?<=\\/)[A-Za-z]+'},
        {name: 'support.function.pidraw', match: '(?<=->|,)\\s*[A-Za-z_*!?]+(?==|,|$|\\/)'}
    ]
}

// The site is served from https://basilgass.github.io/PiDraw/, hence the base.
export default defineConfig({
    title: 'PiDraw',
    description: 'Draw geometry and function plots in SVG from a short text syntax.',
    base: '/PiDraw/',
    lang: 'en-US',
    cleanUrls: true,
    lastUpdated: true,
    // The API reference (docs/public/api) is generated by TypeDoc and links back to the site.
    ignoreDeadLinks: [/^\/PiDraw\/api\//, /\/api\//],
    vite: {
        resolve: {
            // The examples run the library from its sources: they cannot drift from the API, and need no build.
            alias: [
                {find: /^pidraw\/codemirror$/, replacement: fileURLToPath(new URL('../../src/codemirror/index.ts', import.meta.url))},
                {find: /^pidraw$/, replacement: fileURLToPath(new URL('../../src/index.ts', import.meta.url))}
            ]
        }
    },
    markdown: {
        languages: [pidraw],
        config: (md) => {
            // A ```pidraw block is shown as code, with the drawing it makes under it (see theme/fence.ts).
            const fence = md.renderer.rules.fence!

            md.renderer.rules.fence = (tokens, index, options, env, self) => {
                const token = tokens[index]
                const example = parseInfo(token.info)

                if (example === null) {
                    return fence(tokens, index, options, env, self)
                }

                const code = fence(tokens, index, options, env, self)

                const params = md.utils.escapeHtml(example.params)

                return `${code}<PiDrawExample code="${encodeURIComponent(token.content)}" params="${params}" />`
            }
        }
    },
    head: [
        // The labels written with `tex=` are drawn by KaTeX.
        ['link', {rel: 'stylesheet', href: 'https://cdn.jsdelivr.net/npm/katex@0.19.1/dist/katex.min.css', crossorigin: ''}]
    ],
    themeConfig: {
        nav: [
            {text: 'Guide', link: '/guide/getting-started'},
            {text: 'Demo', link: '/demo'},
            {text: 'Controls', link: '/controls'},
            {text: 'API reference', link: '/api/index.html', target: '_self'}
        ],
        sidebar: [
            {
                text: 'Guide',
                items: [
                    {text: 'Getting started', link: '/guide/getting-started'},
                    {text: 'Syntax', link: '/guide/syntax'},
                    {text: 'The graph', link: '/guide/graph'},
                    {text: 'Options', link: '/guide/options'},
                    {text: 'Reference of the keys', link: '/guide/reference'}
                ]
            },
            {
                text: 'Figures',
                items: [
                    {text: 'Points', link: '/guide/points'},
                    {text: 'Lines', link: '/guide/lines'},
                    {text: 'Circles and arcs', link: '/guide/circles'},
                    {text: 'Functions and curves', link: '/guide/curves'},
                    {text: 'Polygons and paths', link: '/guide/polygons'},
                    {text: 'Grids and graduated lines', link: '/guide/grids-axes'}
                ]
            },
            {
                text: 'Going further',
                items: [
                    {text: 'Dragging and animation', link: '/guide/interaction'},
                    {text: 'Slides', link: '/guide/slides'},
                    {text: 'Using it from code', link: '/guide/code'},
                    {text: 'Errors and editing', link: '/guide/errors'},
                    {text: 'TikZ export', link: '/guide/tikz'},
                    {text: 'Migration', link: '/guide/migration'}
                ]
            }
        ],
        socialLinks: [{icon: 'github', link: 'https://github.com/basilgass/PiDraw'}],
        search: {provider: 'local'},
        editLink: {
            pattern: 'https://github.com/basilgass/PiDraw/edit/master/docs/:path',
            text: 'Edit this page on GitHub'
        },
