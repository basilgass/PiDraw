{
  "name": "pidraw",
  "version": "0.3.0",
  "description": "A drawing library for teacher :)",
  "type": "module",
  "main": "dist/pidraw.js",
  "module": "dist/pidraw.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/pidraw.js",
      "require": "./dist/pidraw.js"
    },
    "./codemirror": {
      "types": "./types/codemirror/index.d.ts",
      "import": "./dist/codemirror.js"
    }
  },
  "./types/index.d.ts": "./types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "test": "vitest",
    "test:quick": "vitest run --mode quick",
    "test:full": "vitest run --mode full",
    "bench": "vitest run --mode bench",
    "dev": "vite",
    "build": "tsc --p ./tsconfig-build.json && vite build",
    "preview": "vite preview",
    "dependencies:check": "depcruise src --config .dependency-cruiser.cjs",
    "dependency-cruise": "dependency-cruise -T dot -x node_modules -v -- src/index.ts  | dot -T svg > dependencies.svg",
    "docs:api": "typedoc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "npm run docs:check && typedoc && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "vitest run --mode docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basilgass/PiDraw.git"
  },
  "keywords": [
    "math",
    "drawing",
    "geometry",
    "plot"
  ],
  "author": "Basil Gass",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/basilgass/PiDraw/issues"
  },
  "homepage": "https://github.com/basilgass/PiDraw#readme",
  "dependencies": {
    "@svgdotjs/svg.draggable.js": "^3.0.7",
    "@svgdotjs/svg.js": "^3.2.8",
    "piparser": "^0.2.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/eslint": "^9.6.1",
    "@types/glob": "^9.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.2",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "katex": "^0.19.1",
    "postcss": "^8.5.16",
    "svgdom": "^0.1.29",
    "tailwindcss": "^4.3.3",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@codemirror/autocomplete": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/highlight": {
      "optional": true
    }
  }
}
