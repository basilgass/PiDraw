{
  "name": "pidraw",
  "version": "0.2.26",
  "description": "A drawing library for teacher :)",
  "type": "module",
  "main": "dist/pidraw.js",
  "module": "dist/pidraw.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/pidraw.js",
      "require": "./dist/pidraw.js"
    }
  },
  "./types/index.d.ts": "./types/index.d.ts",
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "test": "vitest",
    "dev": "vite",
    "build": "tsc --p ./tsconfig-build.json && vite build",
    "preview": "vite preview",
    "dependency-cruise": "dependency-cruise -T dot -x node_modules -v -- src/index.ts  | dot -T svg > dependencies.svg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basilgass/PiDraw.git"
  },
  "keywords": [
    "math",
    "drawing",
    "geometry",
    "plot"
  ],
  "author": "Basil Gass",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/basilgass/PiDraw/issues"
  },
  "homepage": "https://github.com/basilgass/PiDraw#readme",
  "dependencies": {
    "@svgdotjs/svg.draggable.js": "^3.0.6",
    "@svgdotjs/svg.js": "^3.2.5",
    "piparser": "^0.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/eslint": "^9.6.1",
    "@types/glob": "^9.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "autoprefixer": "^10.5.2",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "katex": "^0.17.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
